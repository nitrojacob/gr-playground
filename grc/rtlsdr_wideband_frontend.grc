  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: Pure Wideband Spectrum File Sink (2.4 MSps Raw SigMF Data)
    file: file_prefix + '.sigmf-data'
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 280]
    rotation: 0
    state: enabled

connections:
- [blocks_copy_0, '0', wideband_file_sink, '0']
- [capture_enable, state, epy_block_sigmf_writer, msg_in]
- [rtlsdr_source, '0', blocks_copy_0, '0']
- [rtlsdr_source, '0', qtgui_sink_x_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
